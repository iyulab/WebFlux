<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are stand-alone executables (BD-20260829-xunit-v3-pilot) -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>

  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit v3 pilot rollout: xunit replaced with xunit.v3, no Microsoft.NET.Test.Sdk (not
         required under Microsoft.Testing.Platform), coverlet.collector dropped (unused: CI
         never invoked collect against it). xunit.runner.visualstudio kept for IDE Test
         Explorer discovery. -->
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- MTP equivalent of the ecosystem's VSTest blame-hang convention (BD-20260828-07) -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WebFlux\WebFlux.csproj" />
    <!-- The split's contract is that adding this package fills the Dynamic key and nothing else
         changes. Asserting that needs the real registration, not a stand-in registered by hand. -->
    <ProjectReference Include="..\..\src\WebFlux.Playwright\WebFlux.Playwright.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\HtmlSnapshots\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\GoldenFiles\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

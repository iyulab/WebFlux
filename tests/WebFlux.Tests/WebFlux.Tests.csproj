<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are stand-alone executables -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>

  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit v3: no Microsoft.NET.Test.Sdk (not required under Microsoft.Testing.Platform).
         xunit.runner.visualstudio is kept for IDE Test Explorer discovery. -->
    <PackageReference Include="Iyu.Conventions.Testing" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Hang dumps for stuck tests: the Microsoft.Testing.Platform equivalent of VSTest's blame-hang -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- The tutorial's provider examples are written against the OpenAI SDK; DocSnippetCompileTests compiles them. -->
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WebFlux\WebFlux.csproj" />
    <!-- The split's contract is that adding this package fills the Dynamic key and nothing else
         changes. Asserting that needs the real registration, not a stand-in registered by hand. -->
    <ProjectReference Include="..\..\src\WebFlux.Playwright\WebFlux.Playwright.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\HtmlSnapshots\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\GoldenFiles\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Project>
  <!-- 🎯 Central Package Version Management -->
  <!-- 모든 패키지 버전을 여기서 중앙 관리합니다 -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 🔧 Microsoft.Extensions.* (Runtime) -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 🌐 Web Crawling & HTML Processing -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.13.1" />
    <!-- 1.5.0 fixes GHSA-pgww-w46g-26qg (mXSS via annotation-xml HTML integration point,
         vulnerable < 1.5.0). NU1902 promotes this to a build error under TreatWarningsAsErrors. -->
    <PackageVersion Include="AngleSharp" Version="1.8.5" />
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 📝 Document Processing -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <PackageVersion Include="Markdig" Version="1.4.2" />
    <PackageVersion Include="ReverseMarkdown" Version="6.3.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 🛡️ Resilience -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <PackageVersion Include="Polly" Version="8.8.0" />
    <PackageVersion Include="Polly.Extensions.Http" Version="3.0.0" />
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 🧩 Flux Ecosystem -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <PackageVersion Include="Flux.Abstractions" Version="0.27.0" />
    <!-- Chunking is delegated to FluxCurator rather than re-implemented here.
         This moves WebFlux one tier down the release order: FluxCurator must publish first. -->
    <PackageVersion Include="FluxCurator.Core" Version="0.19.0" />
    <PackageVersion Include="FluxCurator" Version="0.19.0" />
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 🤖 AI Services -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 🔗 Source Link -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 🧪 Testing (xUnit v3 / Microsoft.Testing.Platform) -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Iyu.Conventions.Testing" Version="0.13.0" />
    <PackageVersion Include="Iyu.Conventions.Testing.Snippets" Version="0.13.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>
</Project>